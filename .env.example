# GateRescue server environment — TEMPLATE WITH PLACEHOLDERS ONLY.
# Copy to .env.local (git-ignored) and fill in real values locally, or set
# them in Vercel → Project → Settings → Environment Variables.
# None of these use the NEXT_PUBLIC_ prefix: they must never reach the browser.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → secret key (sb_secret_...)
# or the legacy service_role key. Server-side only. Never the publishable/anon key.
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key

# Shared code dispatchers enter to start a demo session (at least 8 characters).
DEMO_ACCESS_CODE=replace-with-demo-access-code

# Random string, at least 32 characters, used to sign session cookies.
# Generate with: openssl rand -base64 48
DEMO_SESSION_SECRET=replace-with-random-32-plus-character-secret
